# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the admin dashboard and cron routes to bypass RLS.
# NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret cron-job.org must pass as ?secret= to trigger
# /api/cron/publish-drafts. Generate with: openssl rand -hex 24
CRON_SECRET=

# Analytics (optional) — e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
